# ============================================================
# VélibData Pipeline — Variables d'environnement
# ============================================================
# Copier ce fichier :  cp .env.example .env
# Ne JAMAIS commit le fichier .env
# ============================================================

# --- Azure Identity (Service Principal) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# --- Azure Data Lake Storage Gen2 ---
ADLS_ACCOUNT_NAME=velibdata1c53
ADLS_ACCOUNT_KEY=              # clé d'accès ADLS — récupérer dans Azure Portal > Storage > Access keys
ADLS_CONTAINER_BRONZE=bronze
ADLS_CONTAINER_SILVER=silver
ADLS_CONTAINER_GOLD=gold

# --- Azure SQL Database ---
SQL_SERVER=                    # ex: velibdata-sql.database.windows.net
SQL_DATABASE=                  # ex: velibdata-db
SQL_USER=                      # ex: sqladmin
SQL_PASSWORD=                  # mot de passe SQL Admin

# --- APIs Sources (gratuit, pas de clé requise) ---
VELIB_STATION_STATUS_URL=https://velib-metropole-opendata.smovengo.cloud/opendata/Velib_Metropole/station_status.json
VELIB_STATION_INFO_URL=https://velib-metropole-opendata.smovengo.cloud/opendata/Velib_Metropole/station_information.json
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# --- Logging ---
LOG_LEVEL=INFO
