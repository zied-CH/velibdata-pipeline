{
  "cluster_name": "velibdata-cluster",
  "spark_version": "13.3.x-scala2.12",
  "node_type_id": "Standard_DS3_v2",
  "autoscale": {
    "min_workers": 1,
    "max_workers": 4
  },
  "auto_termination_minutes": 20,
  "spark_conf": {
    "spark.databricks.delta.preview.enabled": "true",
    "spark.hadoop.fs.azure.account.key.velibdata1c53.dfs.core.windows.net": "{{secrets/velibdata/adls-account-key}}"
  },
  "spark_env_vars": {
    "PYSPARK_PYTHON": "/databricks/python3/bin/python3"
  },
  "custom_tags": {
    "project": "velibdata",
    "environment": "production"
  }
}
